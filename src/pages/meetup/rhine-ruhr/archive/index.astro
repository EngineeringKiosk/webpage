---
import MeetupArchiveLayout from '../../../../components/meetup/MeetupArchiveLayout.astro';
import { NEWSLETTER_SOURCES, NEWSLETTER_LISTS, NEWSLETTER_LOCALES } from '../../../../scripts/newsletter-constants.js';

import rhineRuhrImage from '../../../../../public/images/logos/pocast-episode-logo-cover.jpg';
---

<MeetupArchiveLayout
	collectionName="meetup-rhine-ruhr"
	meetupName="Rhine-Ruhr"
	pageTitle="Talks Archive - Engineering Kiosk Rhine-Ruhr Meetup Germany"
	pageDescription="Browse all past talks from the Engineering Kiosk Rhine-Ruhr meetup in Germany. A local community event for software engineers featuring talks on engineering culture, open source and technology."
	ogImage="/images/logos/pocast-episode-logo-cover.jpg"
	badgeText="Tech Meetup Rhine-Ruhr"
	archiveTitle="Engineering Kiosk Rhine-Ruhr<br />Meetup Germany<br />Talks Archive"
	heroImage={rhineRuhrImage}
	heroImageAlt="Engineering Kiosk Meetup Rhine-Ruhr"
	heroImageTitle="Engineering Kiosk Meetup Rhine-Ruhr"
	showNewsletterForm={true}
	newsletterConfig={{ source: NEWSLETTER_SOURCES.MEETUP_ARCHIVE, locale: NEWSLETTER_LOCALES.EN, primaryNewsletter: NEWSLETTER_LISTS.MEETUP_RHINE_RUHR }}
	teamBadge="The local team of Rhine-Ruhr"
	teamTitle="Team Engineering Kiosk Rhine-Ruhr"
	teamDescription="The organizers of Engineering Kiosk Rhine-Ruhr."
	teamEmail="rhine-ruhr@engineeringkiosk.dev"
	teamMembers={[{ memberKey: 'andy-grunwald' }, { memberKey: 'schepp' }, { memberKey: 'dario-tilgner' }]}
/>
